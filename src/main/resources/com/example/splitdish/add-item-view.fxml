<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="700.0" prefWidth="390.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.splitdish.AddItemController">
   <children>
      <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label text="Add Receipt Item">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            <Label minWidth="300.0" prefWidth="300.0" text="Item Name" />
            <TextField fx:id="itemNameField" maxWidth="300.0" promptText="Enter an item name" />
            <Label maxWidth="300.0" prefWidth="300.0" text="Price ($)" />
            <TextField fx:id="itemPriceField" maxWidth="300.0" promptText="0.00" />
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onCancelClick" text="Cancel" />
                  <Button mnemonicParsing="false" onAction="#onSaveClick" text="Save Item" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
